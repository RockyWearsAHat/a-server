.venv/
__pycache__/
*.pyc

# Emulator runtime files
*.sav
*.sav.*
*.state
*.srm

# ROM files - do not commit (except test_roms/ for local testing)
*.gba
*.gb
*.gbc
*.nro
*.nso

# But allow test_roms directory structure
!test_roms/.gitkeep

# macOS
.DS_Store

# Local scratch / Copilot artifacts
wip_local_changes.patch
untitled:*

_worktrees/

# Core dumps from development (configred to output ./core on my machine)
core

# System cache file so copilot gets less confused about what commands are available
.github/SYSTEM.md