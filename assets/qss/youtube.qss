/* AIO YouTube TV experience
   Scoped YouTube styling. Keep tv.qss for global application defaults.
   Design reference: YouTube TV on actual Smart TVs and consoles.
   Palette: bg #0f0f0f, surface #181818, elevated #212121, card #272727,
            border #333, text #f0f0f0, muted #aaaaaa, dim #666666,
            accent #ff0000 (used sparingly: logo, active controls, timeline)
*/

#aioYouTubePage {
  background-color: #0f0f0f;
}

/* ──────────────────────── Shell ──────────────────────── */

#aioYouTubeSidebar {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #151515,
    stop:0.55 #101010,
    stop:1 #0b0b0b);
  border-right: 1px solid rgba(255, 255, 255, 0.05);
}

#aioYouTubeSidebarBrand {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #ff2f2f,
    stop:1 #d40000);
  color: #ffffff;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 700;
  border: 1px solid rgba(255, 255, 255, 0.18);
  padding: 0 16px;
}

#aioYouTubeSidebarBrand[expanded="true"] {
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.2px;
}

#aioYouTubeSidebarBrand[expanded="false"] {
  font-size: 14px;
  font-weight: 700;
  padding: 0 6px;
}

#aioYouTubeMainShell {
  background-color: qradialgradient(cx:0.2, cy:0.0, radius:1.2,
    fx:0.2, fy:0.0,
    stop:0 rgba(145, 12, 12, 0.18),
    stop:0.18 rgba(66, 10, 10, 0.10),
    stop:0.45 rgba(18, 18, 18, 0.00),
    stop:1 #0f0f0f);
}

#aioYouTubeContentShell,
#aioTileSlot,
#guideTextClip,
#aioTileThumbOverlay {
  background: transparent;
}

/* ──────────────────────── Top Bar ──────────────────────── */

#aioTopBar {
  background-color: transparent;
  border: none;
  border-radius: 0px;
}

#aioYouTubePage #aioTopBar {
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding: 2px 0;
}

#aioTopBar QPushButton,
#aioTopBar QToolButton {
  min-height: 32px;
  padding: 0 12px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  color: #f0f0f0;
  background-color: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

#aioTopBar QPushButton:hover,
#aioTopBar QToolButton:hover {
  background-color: #222222;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

#aioTopBar QPushButton:pressed,
#aioTopBar QToolButton:pressed {
  background-color: #1a1a1a;
}

/* ── Player chrome top-bar glass variant ── */
#aioTopBar[player_chrome="true"] {
  background-color: transparent;
  border: none;
}

#aioTopBar[player_chrome="true"] QToolButton {
  background-color: rgba(0, 0, 0, 0.52);
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: #f0f0f0;
  border-radius: 8px;
}

#aioTopBar[player_chrome="true"] QToolButton:hover {
  background-color: rgba(0, 0, 0, 0.74);
  border: 1px solid rgba(255, 255, 255, 0.28);
}

QPushButton#aioYouTubeAccountButton {
  min-height: 40px;
  max-height: 40px;
  min-width: 40px;
  max-width: 40px;
  padding: 0;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 600;
  color: #f0f0f0;
  background-color: #222222;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

QPushButton#aioYouTubeAccountButton:hover {
  background-color: #2a2a2a;
}

QPushButton#aioYouTubeAccountButton[aio_selected="true"] {
  background-color: #222222;
  border: 2px solid rgba(255, 255, 255, 0.88);
}

QPushButton#aioYouTubeAccountButton:pressed {
  background-color: #1a1a1a;
}

/* ──────────────────────── Hero Section ──────────────────────── */

#aioYouTubeHeroRow {
  background: transparent;
}

#aioYouTubeHeroCard {
  background-color: #141414;
  border: 1px solid transparent;
  border-radius: 16px;
}

#aioYouTubeHeroArtwork {
  background-color: #181818;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.55);
  font-size: 20px;
  font-weight: 700;
}

#aioYouTubeHeroScrim {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 rgba(0, 0, 0, 0.96),
    stop:0.30 rgba(0, 0, 0, 0.74),
    stop:0.58 rgba(0, 0, 0, 0.28),
    stop:1 rgba(0, 0, 0, 0.04));
  border-radius: 16px;
}

#aioYouTubeHeroCopy {
  background: transparent;
}

#aioYouTubeHeroEyebrow {
  color: rgba(255,0,0,0.88);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

#aioYouTubeHeroSpotlightEyebrow {
  color: #999999;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1.2px;
}

#aioYouTubeHeroTitle {
  color: #ffffff;
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -0.4px;
}

#aioYouTubeHeroBody {
  color: #f0f0f0;
  font-size: 14px;
  font-weight: 400;
}

QLabel[role="ytHeroChip"] {
  min-height: 24px;
  padding: 0 10px;
  border-radius: 12px;
  background-color: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.10);
  color: #f0f0f0;
  font-size: 12px;
  font-weight: 600;
}

QLabel[role="ytHeroChip"][active="true"] {
  background-color: rgba(255, 120, 108, 0.24);
  border: 1px solid rgba(255, 148, 138, 0.40);
  color: #fff1ef;
}

#aioYouTubeHeroSpotlight {
  background-color: rgba(17, 17, 17, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 16px;
}

#aioYouTubeHeroSpotlightTitle {
  color: #f0f0f0;
  font-size: 16px;
  font-weight: 650;
}

#aioYouTubeHeroSpotlightMeta {
  color: #999999;
  font-size: 12px;
  font-weight: 500;
}

/* ──────────────────────── Browse Header ──────────────────────── */

QLabel[role="ytBrowseHeaderTitle"] {
  color: #ffffff;
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.2px;
}

/* ──────────────────────── Sidebar Guide ──────────────────────── */

#aioYouTubeGuideSection {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 12px;
  min-height: 30px;
}

#aioYouTubeGuideSectionLabel,
#aioYouTubeGuideSectionChevron {
  color: #999999;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.6px;
}

#aioYouTubeGuideItem {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 12px;
  min-height: 50px;
}

#aioYouTubeGuideItem[aio_hovered="true"] {
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.14);
}

#aioYouTubeGuideItem[aio_active_page="true"] {
  background-color: rgba(255, 78, 66, 0.10);
  border: 1px solid rgba(255, 78, 66, 0.22);
  border-left: 3px solid rgba(255,0,0,0.88);
}

#aioYouTubeGuideItem[aio_active_page="true"] QLabel[role="guideText"] {
  color: #ffffff;
  font-weight: 600;
}

#aioYouTubeGuideIconWrap[aio_active_page="true"] {
  background-color: rgba(255, 78, 66, 0.24);
  border: 1px solid rgba(255, 78, 66, 0.38);
}

#aioYouTubeGuideItem[aio_selected="true"] {
  background-color: rgba(255, 255, 255, 0.14);
  border: 3px solid #ffffff;
  border-left: 4px solid rgba(255,0,0,0.88);
}

#aioYouTubeGuideIconWrap {
  background-color: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 11px;
  padding: 0;
}

#aioYouTubeGuideIconWrap[aio_hovered="true"] {
  background-color: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.18);
}

#aioYouTubeGuideIconWrap[aio_selected="true"] {
  background-color: #f6f1ef;
  border: 1px solid rgba(255, 255, 255, 0.22);
}

#aioYouTubeGuideItem[aio_selected="true"] QLabel[role="guideText"] {
  color: #ffffff;
  font-weight: 600;
}

#aioYouTubeGuideItem[aio_hovered="true"] QLabel[role="guideText"] {
  color: #f4f4f4;
}

QLabel[role="guideText"] {
  color: #dfdfdf;
  font-size: 16px;
  font-weight: 500;
}

/* ──────────────────────── Auth / Account Card ──────────────────────── */

#aioYouTubeAccountStrip {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
    stop:0 rgba(255, 255, 255, 0.07),
    stop:1 rgba(255, 255, 255, 0.03));
  border: 1px solid transparent;
  border-radius: 16px;
  min-height: 132px;
}

#aioYouTubeAccountStrip QLabel[role="tileMeta"] {
  color: #a8a8a8;
}

#aioYouTubeAccountAvatar {
  background-color: rgba(255, 255, 255, 0.14);
  border-radius: 20px;
  color: #f0f0f0;
  font-size: 14px;
  font-weight: 600;
}

#aioYouTubeAccountStrip QLabel[role="ytSectionTitle"] {
  font-size: 16px;
  font-weight: 650;
}

#aioYouTubeAccountStrip QLabel[role="ytSectionMeta"] {
  color: #999999;
  font-size: 12px;
  font-weight: 500;
}

#aioYouTubeAccountStrip QPushButton {
  min-height: 38px;
  padding: 0 18px;
  border-radius: 19px;
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.09);
  border: 1px solid rgba(255, 255, 255, 0.16);
}

#aioYouTubeAccountStrip QPushButton:hover {
  background-color: rgba(255, 255, 255, 0.12);
}

#aioYouTubeAccountStrip QPushButton[variant="secondary"] {
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #f0f0f0;
}

#aioYouTubeAccountStrip QPushButton[variant="secondary"]:hover {
  background-color: #222222;
}

#aioYouTubeAccountStrip[aio_tile_hovered="true"] {
  border: 1px solid rgba(255, 255, 255, 0.16);
  background-color: rgba(255, 255, 255, 0.05);
}

#aioYouTubeAccountStrip[aio_tile_selected="true"] {
  border: 2px solid rgba(255, 255, 255, 0.94);
  background-color: rgba(255, 255, 255, 0.10);
}

#aioYouTubeAccountStrip[aio_tile_selected="true"] QLabel[role="tileTitle"] {
  color: #ffffff;
}

#aioYouTubeAccountStrip[aio_tile_selected="true"] QLabel[role="tileMeta"] {
  color: #f0f0f0;
}

#aioYouTubeStatusLabel {
  color: #999999;
  font-size: 13px;
}

#aioYouTubeAuthQr {
  background-color: #ffffff;
  border-radius: 12px;
  border: none;
  color: #0f0f0f;
  padding: 6px;
}

/* ──────────────────────── Search ──────────────────────── */

QLineEdit#aioYouTubeSearch {
  min-height: 44px;
  font-size: 16px;
  font-weight: 400;
  background-color: rgba(255, 255, 255, 0.07);
  border: 2px solid rgba(255, 255, 255, 0.10);
  border-radius: 20px;
  padding: 8px 22px 8px 22px;
  color: #f0f0f0;
  selection-background-color: rgba(255,0,0,0.72);
}

QLineEdit#aioYouTubeSearch:focus {
  border: 2px solid rgba(255, 255, 255, 0.7);
  background-color: rgba(255, 255, 255, 0.12);
}

QPushButton#aioYouTubeSearchButton {
  min-height: 40px;
  padding: 0 24px;
  font-size: 14px;
  font-weight: 500;
  border-radius: 20px;
  color: #ffffff;
  background-color: #1a1a1a;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

QPushButton#aioYouTubeSearchButton:hover {
  background-color: #222222;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

QPushButton#aioYouTubeSearchButton:pressed {
  background-color: #161616;
}

/* ──────────────────────── Player Header ──────────────────────── */

QLabel[role="ytPlayerHeaderTitle"] {
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
}

#aioYouTubePlayerStateChip,
#aioYouTubePlayerFocusChip {
  min-height: 32px;
  padding: 0 12px;
  border-radius: 6px;
  color: #f0f0f0;
  font-size: 12px;
  font-weight: 500;
  background-color: #1a1a1a;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

#aioYouTubePlayerStateChip[state="loading"] {
  background-color: rgba(62, 166, 255, 0.15);
  border: 1px solid rgba(62, 166, 255, 0.30);
  color: #3ea6ff;
}

#aioYouTubePlayerStateChip[state="playing"] {
  background-color: rgba(46, 160, 67, 0.15);
  border: 1px solid rgba(46, 160, 67, 0.30);
  color: #3fb950;
}

#aioYouTubePlayerStateChip[state="paused"] {
  background-color: #1a1a1a;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

#aioYouTubePlayerStateChip[state="error"] {
  background-color: rgba(255, 0, 0, 0.15);
  border: 1px solid rgba(255, 0, 0, 0.30);
  color: #ff4444;
}

#aioYouTubePlayerFocusChip[active="true"] {
  background-color: rgba(255, 255, 255, 0.10);
  border: 2px solid rgba(255, 255, 255, 0.88);
}

/* ──────────────────────── Section Labels ──────────────────────── */

QLabel[role="ytSectionTitle"] {
  color: #ffffff;
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 0.1px;
}

QLabel[role="ytSectionMeta"] {
  color: #999999;
  font-size: 14px;
  font-weight: 500;
}

QLabel[role="ytRailCountChip"] {
  min-height: 28px;
  padding: 0 12px;
  border-radius: 15px;
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #f0f0f0;
  font-size: 13px;
  font-weight: 600;
}

/* ──────────────────────── Content Rails ──────────────────────── */

#aioRailBlock {
  background-color: transparent;
  border: none;
  border-radius: 0px;
  margin-bottom: 8px;
}

#aioRailBlock[hero_rail="true"] {
  background-color: transparent;
  border: none;
}

#aioRailBlock QLabel[role="ytSectionTitle"] {
  font-size: 20px;
  font-weight: 700;
}

#aioRailScroller QScrollBar:horizontal {
  background: transparent;
  height: 6px;
  margin: 4px 12px 0 12px;
}

#aioRailScroller QScrollBar::handle:horizontal {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 3px;
  min-width: 48px;
}

#aioRailScroller QScrollBar::handle:horizontal:hover {
  background: rgba(255, 255, 255, 0.24);
}

#aioRailScroller QScrollBar::add-line:horizontal,
#aioRailScroller QScrollBar::sub-line:horizontal,
#aioRailScroller QScrollBar::add-page:horizontal,
#aioRailScroller QScrollBar::sub-page:horizontal {
  background: transparent;
  width: 0px;
}

#aioRailHeader {
  background: transparent;
}

#aioYouTubeContentShell QScrollBar:vertical,
#aioYouTubeMainShell QScrollBar:vertical,
#aioYouTubeSidebar QScrollBar:vertical {
  width: 0px;
  background: transparent;
}

#aioYouTubeContentShell QScrollBar::handle:vertical,
#aioYouTubeContentShell QScrollBar::add-line:vertical,
#aioYouTubeContentShell QScrollBar::sub-line:vertical,
#aioYouTubeContentShell QScrollBar::add-page:vertical,
#aioYouTubeContentShell QScrollBar::sub-page:vertical,
#aioYouTubeMainShell QScrollBar::handle:vertical,
#aioYouTubeMainShell QScrollBar::add-line:vertical,
#aioYouTubeMainShell QScrollBar::sub-line:vertical,
#aioYouTubeMainShell QScrollBar::add-page:vertical,
#aioYouTubeMainShell QScrollBar::sub-page:vertical,
#aioYouTubeSidebar QScrollBar::handle:vertical,
#aioYouTubeSidebar QScrollBar::add-line:vertical,
#aioYouTubeSidebar QScrollBar::sub-line:vertical,
#aioYouTubeSidebar QScrollBar::add-page:vertical,
#aioYouTubeSidebar QScrollBar::sub-page:vertical {
  background: transparent;
  height: 0px;
}

/* ──────────────────────── Content Tiles ──────────────────────── */

#aioTile {
  background-color: transparent;
  border: 2px solid transparent;
  border-radius: 16px;
}

QLabel[role="thumb"] {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #1a1a1a,
    stop:0.5 #222222,
    stop:1 #1a1a1a);
  border: none;
  border-radius: 12px;
  color: transparent;
  font-size: 1px;
}

#aioTileCopy {
  background: transparent;
  border-radius: 0 0 18px 18px;
}

#aioTile[aio_tile_selected="true"] {
  background-color: rgba(255, 255, 255, 0.10);
  border: 3px solid rgba(255,255,255,0.95);
  border-radius: 16px;
}

#aioTile[aio_tile_selected="true"] #aioTileThumbFrame {
  border-radius: 12px;
  border: 1.5px solid rgba(255, 255, 255, 0.50);
  background-color: rgba(255, 255, 255, 0.06);
}

#aioTile[aio_tile_selected="true"] QLabel[role="tileTitle"] {
  color: #ffffff;
  font-weight: 760;
}

#aioTile[aio_tile_selected="true"] QLabel[role="tileMeta"] {
  color: #f7f7f7;
}

#aioTile[aio_tile_hovered="true"] {
  background-color: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.22);
}

#aioTile[aio_tile_selected="true"] QLabel[role="thumb"] {
  border: 0px;
}

#aioTile[aio_tile_selected="true"] QLabel[role="tileBadge"],
#aioTile[aio_tile_selected="true"] QLabel[role="tileDurationBadge"] {
  background-color: rgba(0, 0, 0, 0.84);
  border: 1px solid rgba(255, 255, 255, 0.34);
  color: #ffffff;
}

#aioTile[aio_tile_hovered="true"] QLabel[role="thumb"] {
  border: 0px;
}

QLabel[role="thumb"][aio_thumb_missing="true"] {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1c1c1c,
    stop:0.5 #181818,
    stop:1 #141414);
  border: 1px solid rgba(255, 255, 255, 0.10);
  color: rgba(255, 255, 255, 0.22);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.5px;
}

#aioTile[aio_tile_selected="true"] QLabel[role="thumb"][aio_thumb_missing="true"] {
  border: 1px solid rgba(255, 255, 255, 0.44);
  color: #ffffff;
}

QLabel[role="tileDurationBadge"] {
  border-radius: 7px;
  padding: 3px 7px;
  font-size: 13px;
  font-weight: 600;
  background-color: rgba(0, 0, 0, 0.76);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #f0f0f0;
}

QLabel[role="tileBadge"] {
  border-radius: 7px;
  padding: 3px 8px;
  font-size: 12px;
  font-weight: 600;
  background-color: rgba(0, 0, 0, 0.58);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #f0f0f0;
}

QLabel[role="tileTitle"] {
  color: #f0f0f0;
  font-size: 16px;
  font-weight: 650;
}

QLabel[role="tileMeta"] {
  color: #a6a6a6;
  font-size: 14px;
  font-weight: 500;
}

#aioTileThumbFrame,
#aioYouTubeRecommendationThumbFrame {
  border-radius: 12px;
  background: transparent;
}

/* ──────────────────────── Player Stage ──────────────────────── */

#aioYouTubeVideoStage {
  background-color: #0a0a0a;
}

#aioYouTubeVideoStage[recommendations_active="true"] {
  background-color: #080808;
}

#aioYouTubePlaybackSurface,
#aioYouTubePlaybackView {
  background-color: #000000;
  border-radius: 0px;
}

#aioYouTubePlaybackSurface {
  border: none;
}

#aioYouTubeCenterStageCard {
  background-color: rgba(20, 20, 20, 0.96);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 12px;
}

#aioYouTubeCenterStageEyebrow {
  color: rgba(255,0,0,0.72);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

#aioYouTubeCenterStageTitle {
  color: #ffffff;
  font-size: 22px;
  font-weight: 700;
}

#aioYouTubeCenterStageBody {
  color: #c0c0c0;
  font-size: 16px;
  font-weight: 400;
}

#aioYouTubeCenterStageAction {
  color: #666666;
  font-size: 13px;
  font-weight: 400;
}

/* ──────────────────────── Chrome Overlay ──────────────────────── */

#aioYouTubeChromeOverlay {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 rgba(0, 0, 0, 0.60),
    stop:0.18 rgba(0, 0, 0, 0.10),
    stop:0.82 rgba(0, 0, 0, 0.10),
    stop:1 rgba(0, 0, 0, 0.70));
}

#aioYouTubeChromeOverlay[compact_chrome="true"] {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 rgba(0, 0, 0, 0.20),
    stop:0.15 rgba(0, 0, 0, 0.00),
    stop:0.85 rgba(0, 0, 0, 0.00),
    stop:1 rgba(0, 0, 0, 0.28));
}

#aioYouTubeChromeOverlay[recommendations_active="true"] {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 rgba(0, 0, 0, 0.70),
    stop:0.18 rgba(0, 0, 0, 0.30),
    stop:0.65 rgba(0, 0, 0, 0.50),
    stop:1 rgba(0, 0, 0, 0.85));
}

#aioYouTubePlayerStatus {
  padding: 8px 16px;
  border-radius: 12px;
  background-color: rgba(0, 0, 0, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.10);
  color: rgba(255, 255, 255, 0.85);
  font-size: 14px;
  font-weight: 500;
}

/* ──────────────────────── Player Overlay Panel ──────────────────────── */

#aioYouTubePlayerOverlay,
#aioYouTubePlayerOverlay[player_dock="true"] {
  background-color: rgba(14, 14, 14, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 16px;
}

#aioYouTubePlayerOverlay QLabel[role="ytSectionTitle"] {
  font-size: 18px;
}

#aioYouTubePlayerOverlay QLabel[role="ytSectionMeta"] {
  color: #999999;
}

#aioYouTubePlayerOverlay[recommendations_active="true"] {
  background-color: rgba(12, 12, 12, 0.97);
  border: 1px solid #333333;
}

#aioYouTubePlayerOverlay[recommendations_expanded="true"] {
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

/* ── compact chrome overlay (playing + video focused) ── */
#aioYouTubePlayerOverlay[compact_chrome="true"] {
  background-color: transparent;
  border: 1px solid transparent;
}

#aioYouTubeOverlayHeaderCard {
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 16px;
}

#aioYouTubeOverlayEyebrow {
  color: rgba(255,0,0,0.72);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1.3px;
}

#aioYouTubeOverlayChannelName {
  color: #999999;
  font-size: 14px;
  font-weight: 500;
}

/* ──────────────────────── Transport Bar ──────────────────────── */

#aioYouTubeTransportBar {
  background-color: rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
}

QLabel[role="ytTransportChip"] {
  color: #f0f0f0;
  background-color: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 0 14px;
  font-size: 14px;
  font-weight: 500;
}

QLabel[role="ytTransportChip"][active="true"] {
  background-color: rgba(255, 116, 104, 0.22);
  border: 1px solid rgba(255, 146, 136, 0.42);
  color: #ffffff;
}

QLabel[role="ytTransportChip"][emphasis="true"] {
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.50);
}

/* ──────────────────────── Timeline ──────────────────────── */

#aioYouTubeTimelineCard {
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background-color: rgba(255, 255, 255, 0.035);
}

#aioYouTubeTimeline {
  min-height: 28px;
}

#aioYouTubeTimeline::groove:horizontal {
  border: none;
  height: 4px;
  border-radius: 2px;
  background-color: #222222;
}

#aioYouTubeTimeline::sub-page:horizontal {
  border-radius: 2px;
  background-color: rgba(255,0,0,0.72);
}

#aioYouTubeTimeline::add-page:horizontal {
  border-radius: 2px;
  background-color: #222222;
}

#aioYouTubeTimeline::handle:horizontal {
  background-color: #ffffff;
  width: 12px;
  margin: -6px 0;
  border-radius: 6px;
}

#aioYouTubeTimeline::handle:horizontal:hover,
#aioYouTubeTimeline[selected="true"]::handle:horizontal {
  background-color: #ffffff;
  width: 16px;
  border-radius: 8px;
}

#aioYouTubeTimeline[selected="true"]::groove:horizontal {
  background-color: #2a2a2a;
}

/* ──────────────────────── Recommendation Tiles ──────────────────────── */

#aioYouTubeRecommendationTile {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 16px;
  min-height: 200px;
}

#aioYouTubeRecommendationTile[selected="true"] {
  background-color: rgba(255, 255, 255, 0.08);
  border: 2px solid rgba(255, 255, 255, 0.88);
}

#aioYouTubeRecommendationTile QLabel[role="thumb"] {
  border-radius: 12px;
}

#aioYouTubeRecommendationTile QLabel[role="tileBadge"] {
  background-color: rgba(0, 0, 0, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

#aioYouTubeRecommendationTile QLabel[role="tileTitle"] {
  color: #f0f0f0;
  font-size: 14px;
  font-weight: 650;
}

#aioYouTubeRecommendationTile QLabel[role="tileMeta"] {
  color: #999999;
  font-size: 13px;
  font-weight: 500;
}

#aioYouTubeRecommendationTile[selected="true"] QLabel[role="tileMeta"] {
  color: #f0f0f0;
}

#aioYouTubeRecommendationTile[selected="true"] QLabel[role="thumb"] {
  border: 0px;
}

/* ──────────────────────── Autoplay Countdown Chip ──────────────────────── */

#aioYouTubeAutoplayChip {
  background-color: rgba(0, 0, 0, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.20);
  border-radius: 20px;
  padding: 12px 28px;
  color: #f0f0f0;
  font-size: 18px;
  font-weight: 600;
}

/* ──────────────────────── Tile Watch Progress ──────────────────────── */

#aioTileProgressTrack {
  background-color: rgba(255, 255, 255, 0.22);
  border-radius: 0px;
}

#aioTileProgressFill {
  background-color: rgba(255,0,0,0.72);
  border-radius: 0px;
}

/* ──────────────────────── Search Suggestions ──────────────────────── */

#aioYouTubeSuggestionDropdown {
  background-color: #121212;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
}

#aioYouTubeSuggestionList {
  background-color: transparent;
  border: none;
  border-radius: 12px;
  padding: 4px;
  font-size: 14px;
}

#aioYouTubeSuggestionList::item {
  color: #f0f0f0;
  padding: 8px 16px;
  border-radius: 6px;
}

#aioYouTubeSuggestionList::item:hover {
  background-color: rgba(255, 255, 255, 0.08);
}

#aioYouTubeSuggestionList::item:selected {
  background-color: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

/* ──────────────────────── Category Filter Chips ──────────────────────── */

#aioYouTubeCategoryScroll {
  background: transparent;
  border: none;
}

#aioYouTubeCategoryStrip {
  background: transparent;
}

#aioYouTubeCategoryChip {
  min-height: 42px;
  padding: 0 22px;
  border-radius: 20px;
  font-size: 16px;
  font-weight: 600;
  color: #f0f0f0;
  background-color: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

#aioYouTubeCategoryChip:hover {
  background-color: rgba(255, 255, 255, 0.10);
  border: 1px solid rgba(255, 255, 255, 0.28);
}

#aioYouTubeCategoryChip[active="true"] {
  background-color: rgba(255, 20, 20, 0.16);
  color: #ff4040;
  border: 1px solid rgba(255, 40, 40, 0.48);
  font-weight: 700;
}

#aioYouTubeCategoryChip:checked {
  background-color: rgba(255, 20, 20, 0.16);
  color: #ff4040;
  border: 1px solid rgba(255, 40, 40, 0.48);
  font-weight: 700;
}

#aioYouTubeCategoryChip[aio_selected="true"] {
  background-color: rgba(255, 20, 20, 0.16);
  color: #ff4040;
  border: 1px solid rgba(255, 40, 40, 0.48);
  font-weight: 700;
  padding: 0 22px;
}

/* ── Skeleton loading states ── */
#aioSkeletonTile {
  background-color: #181818;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.04);
}

#aioSkeletonThumb {
  background-color: #1a1a1a;
  border-radius: 12px 12px 0 0;
}

#aioSkeletonTextBar {
  background-color: #1a1a1a;
  border-radius: 4px;
}

/* ── Stronger focus for TV ── */
#aioYouTubeCategoryChip:focus,
#aioYouTubeCategoryChip[active="true"]:focus {
  border: 2px solid rgba(255, 255, 255, 0.80);
}

/* Guide item focus */
.QWidget[aio_guide_selected="true"] {
  background-color: rgba(255, 255, 255, 0.12);
  border: 1.5px solid rgba(255, 255, 255, 0.4);
  border-radius: 8px;
}

/* ──────────────────────── LIVE Badge ──────────────────────── */

QLabel[role="tileLiveBadge"] {
  border-radius: 7px;
  padding: 3px 8px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  background-color: rgba(255, 112, 100, 0.90);
  border: 1px solid rgba(255, 205, 201, 0.28);
  color: #ffffff;
}

/* ──────────────────────── See All Card ──────────────────────── */

#aioSeeAllCard {
  background-color: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
}

#aioSeeAllCard:hover {
  background-color: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.16);
}

QLabel[role="seeAllText"] {
  color: #999999;
  font-size: 14px;
  font-weight: 600;
}
