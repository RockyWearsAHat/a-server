/* ══════════════════════════════════════════════════════════════
   AIO Entertainment System — TV Shell Design System
   ──────────────────────────────────────────────────────────────
   Palette
     bg:       #0a0a0a          surface-1: #121212
     surface-2:#1a1a1a          surface-3: #222222
     elevated: #2a2a2a          border:    rgba(255,255,255,0.06)
     text:     #f0f0f0          text-2:    #999999
     text-3:   #666666          accent:    #64b5f6
   Typography  (Noto Sans)
     display 48/800  heading 32/700  section 20/600
     body 16/500     caption 14/500  meta 13/500  small 12/500
   Spacing     4 · 8 · 12 · 16 · 24 · 32 · 48 · 64
   Radius      card 16  button 12  chip 20  badge 6  input 12
   ══════════════════════════════════════════════════════════════ */

/* ──────────────────── Foundation ──────────────────── */

QMainWindow {
  background-color: #0a0a0a;
  color: #f0f0f0;
}

QWidget {
  background-color: transparent;
  color: #f0f0f0;
  font-family: "Noto Sans", sans-serif;
  font-size: 14px;
}

/* ──────────────────── Page Backgrounds ──────────────────── */

QWidget#aioHomeScreen,
QWidget#aioMainMenuPage,
QWidget#aioEmulatorSelectPage,
QWidget#aioGameSelectPage,
QWidget#aioSettingsPage,
QWidget#aioEmulatorSettingsPage,
QWidget#aioStreamingHub,
QWidget#aioStreamingWebPage,
QWidget#nasPageRoot,
QWidget#aioScreenMirrorPage,
QWidget#aioGamesLibraryPage,
QWidget#aioGameStorePage,
QWidget#aioEmulatorPage {
  background-color: #0a0a0a;
}

/* ──────────────────── Labels ──────────────────── */

QLabel {
  color: #f0f0f0;
  background-color: transparent;
}

QLabel[role="title"] {
  font-size: 32px;
  font-weight: 700;
  color: #f0f0f0;
}

QLabel[role="subtitle"] {
  font-size: 18px;
  color: #999999;
}

QLabel[role="sectionEyebrow"] {
  font-size: 13px;
  font-weight: 700;
  color: #64b5f6;
  letter-spacing: 1.6px;
}

/* ──────────────────── Top Bar ──────────────────── */

#aioTopBar {
  background-color: rgba(10, 10, 10, 0.92);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding: 4px 0;
}

/* ──────────────────── Buttons ──────────────────── */

QToolButton,
QPushButton {
  background-color: #1a1a1a;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 16px 24px;
  font-size: 14px;
  font-weight: 600;
  min-height: 52px;
}

QToolButton {
  min-height: 32px;
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  border-radius: 8px;
}

QPushButton:hover,
QToolButton:hover {
  background-color: #222222;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

QPushButton:pressed,
QToolButton:pressed {
  background-color: #161616;
}

QPushButton[variant="secondary"],
QToolButton[variant="secondary"] {
  background-color: #121212;
  color: #cccccc;
}

QPushButton[variant="danger"] {
  background-color: rgba(220, 50, 50, 0.16);
  border: 1px solid rgba(220, 50, 50, 0.32);
  color: #f0a0a0;
}

/* ── Focus / Selected (universal) ── */

QPushButton[aio_selected="true"],
QPushButton[aio_selected="true"]:hover,
QPushButton[variant][aio_selected="true"],
QPushButton[variant][aio_selected="true"]:hover,
QToolButton[aio_selected="true"],
QToolButton[aio_selected="true"]:hover {
  background-color: rgba(100, 181, 246, 0.22);
  border: 3px solid #ffffff;
  color: #ffffff;
}

/* ── Main nav buttons ── */

QPushButton[nav_kind="main"] {
  min-height: 64px;
  padding: 16px 24px;
  font-size: 20px;
  text-align: left;
  background-color: #121212;
  border-left: 4px solid rgba(100, 181, 246, 0.32);
}

QPushButton[nav_kind="main"]:hover {
  border-left: 4px solid rgba(100, 181, 246, 0.56);
}

QPushButton[nav_kind="main"][aio_selected="true"] {
  border-left: 4px solid #64b5f6;
}

/* ── System-branded buttons ── */

QPushButton[system="gba"],
QPushButton[system="ps1"],
QPushButton[system="switch"] {
  text-align: left;
  padding-left: 24px;
}

QPushButton[system="gba"] {
  border-left: 4px solid #9c8cff;
}

QPushButton[system="ps1"] {
  border-left: 4px solid #64b5f6;
}

QPushButton[system="switch"] {
  border-left: 4px solid #ff6b6b;
}

QPushButton[system="gba"][aio_selected="true"] {
  border-left: 4px solid #b8a8ff;
}

QPushButton[system="ps1"][aio_selected="true"] {
  border-left: 4px solid #90caf9;
}

QPushButton[system="switch"][aio_selected="true"] {
  border-left: 4px solid #ff9090;
}

/* ──────────────────── Lists ──────────────────── */

QListWidget {
  background-color: #121212;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
  padding: 12px;
  font-size: 14px;
}

QListWidget::item {
  padding: 12px;
  border-radius: 8px;
  margin: 4px 0;
}

QListWidget::item:selected {
  background-color: rgba(100, 181, 246, 0.22);
  border: 3px solid #ffffff;
}

QListWidget::item:hover {
  background-color: rgba(255, 255, 255, 0.04);
}

QListWidget#nasList,
QListWidget#aioGameGrid {
  padding: 16px;
  border-radius: 16px;
}

QListWidget#aioGameGrid {
  background-color: rgba(18, 18, 18, 0.80);
}

QListWidget#aioGameGrid::item {
  padding: 12px;
  margin: 4px;
  border-radius: 8px;
}

QListWidget#aioGameGrid::item:selected {
  background-color: rgba(100, 181, 246, 0.12);
  border: 2px solid white;
}

/* ──────────────────── Inputs ──────────────────── */

QLineEdit,
QTextEdit,
QPlainTextEdit {
  background-color: #121212;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 14px;
  color: #f0f0f0;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QListWidget:focus {
  border: 2px solid rgba(100, 181, 246, 0.80);
}

/* ──────────────────── Checkboxes ──────────────────── */

QCheckBox {
  color: #f0f0f0;
}

/* ──────────────────── Group Boxes ──────────────────── */

QGroupBox {
  background-color: rgba(18, 18, 18, 0.80);
  border: 1px solid transparent;
  border-radius: 16px;
  margin-top: 16px;
  padding: 24px 16px 16px 16px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 16px;
  padding: 0 8px;
  color: #999999;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.4px;
}

/* ──────────────────── NAS Path & Status ──────────────────── */

#aioPathLabel,
#nasPath {
  background-color: #121212;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 12px 16px;
  color: #cccccc;
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 13px;
}

#nasStatus,
#aioStreamingWebStatus,
#aioStreamingWebErrorLabel {
  color: #999999;
  font-size: 14px;
  padding-left: 16px;
}

#aioStreamingWebErrorStrip {
  background-color: rgba(220, 50, 50, 0.08);
  border-top: 1px solid rgba(220, 50, 50, 0.20);
  border-bottom: 1px solid rgba(220, 50, 50, 0.20);
  padding: 14px 0;
}

#aioStreamingWebErrorLabel {
  color: #f0a0a0;
  font-size: 18px;
  font-weight: 500;
}

/* ──────────────────── Streaming Bar Buttons ──────────────────── */

#aioStreamingTopBar {
  background-color: rgba(10, 10, 10, 0.96);
  border-bottom: 2px solid rgba(255, 255, 255, 0.06);
  padding: 0;
}

#aioStreamingTopBar[brand="netflix"] {
  border-bottom: 2px solid rgba(229, 9, 20, 0.50);
}
#aioStreamingTopBar[brand="disneyplus"] {
  border-bottom: 2px solid rgba(30, 80, 240, 0.50);
}
#aioStreamingTopBar[brand="hulu"] {
  border-bottom: 2px solid rgba(28, 231, 131, 0.50);
}
#aioStreamingTopBar[brand="steam-store"] {
  border-bottom: 2px solid rgba(32, 112, 190, 0.50);
}

#aioStreamingBarTitle {
  font-size: 18px;
  font-weight: 700;
  color: #e0e0e0;
  letter-spacing: 0.3px;
}

#aioStreamingBarBtn {
  min-height: 48px;
  padding: 10px 20px;
  font-size: 16px;
  font-weight: 600;
  border-radius: 12px;
  background-color: rgba(255, 255, 255, 0.06);
  color: #d0d0d0;
  border: 1px solid transparent;
}

#aioStreamingBarBtn:focus {
  border: 2px solid rgba(255, 255, 255, 0.88);
  background-color: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

#aioStreamingBarBtn:hover {
  background-color: rgba(255, 255, 255, 0.10);
  color: #f0f0f0;
}

#aioStreamingBarBtn:pressed {
  background-color: rgba(255, 255, 255, 0.16);
  border: 2px solid rgba(255, 255, 255, 0.48);
}

#aioStreamingBarBtn:disabled {
  color: rgba(153, 153, 153, 0.28);
  background-color: rgba(255, 255, 255, 0.02);
}

#aioStreamingRetryBtn {
  min-height: 48px;
  padding: 12px 28px;
  font-size: 16px;
  font-weight: 600;
  border-radius: 12px;
  border: 1px solid rgba(220, 50, 50, 0.32);
  background-color: rgba(220, 50, 50, 0.12);
  color: #ffd4d4;
}

#aioStreamingRetryBtn:focus {
  border: 2px solid rgba(255, 120, 120, 0.72);
  background-color: rgba(220, 50, 50, 0.20);
}

/* ──────────────────── Streaming Loading Overlay ──────────────────── */

#aioStreamingLoadOverlay {
  background-color: #0a0a0a;
}

#aioStreamingLoadTitle {
  font-size: 48px;
  font-weight: 800;
  color: #f0f0f0;
  letter-spacing: 0.5px;
}

#aioStreamingLoadAccent {
  border-radius: 2px;
}

#aioStreamingLoadIndicator {
  font-size: 18px;
  font-weight: 600;
  color: #999999;
  letter-spacing: 2px;
}

/* ──────────────────── Navigation Hint Strip ──────────────────── */

#aioStreamingNavHint {
  font-size: 15px;
  font-weight: 500;
  color: rgba(200, 200, 200, 0.60);
  background-color: rgba(10, 10, 10, 0.80);
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  padding: 6px 24px;
  letter-spacing: 0.8px;
}

/* ──────────────────── NAS Preview ──────────────────── */

#nasPreviewInfo,
#nasImage,
#nasText {
  background-color: #121212;
  border: 1px solid transparent;
  border-radius: 16px;
}

#nasPreviewInfo {
  padding: 16px;
  color: #f0f0f0;
}

#nasImage {
  padding: 8px;
}

/* ──────────────────── Streaming Hub ──────────────────── */

#aioStreamingHubTitle {
  font-size: 13px;
  font-weight: 700;
  color: #64b5f6;
  padding-left: 4px;
  letter-spacing: 1.6px;
}

#aioStreamingHubHeadline {
  font-size: 48px;
  font-weight: 800;
  color: #f0f0f0;
}

#aioStreamingHubDescription {
  font-size: 18px;
  color: #999999;
}

#aioStreamingHubResume {
  background-color: rgba(100, 181, 246, 0.10);
  border: 1px solid rgba(100, 181, 246, 0.24);
  border-radius: 12px;
  padding: 8px 16px;
  color: #90caf9;
  font-size: 13px;
  font-weight: 600;
}

#aioStreamingHubHint {
  font-size: 14px;
  color: #666666;
}

/* ──────────────────── Streaming Tiles ──────────────────── */

#aioStreamingTile {
  border: 1px solid transparent;
  border-radius: 16px;
  min-width: 220px;
  min-height: 300px;
  max-width: 480px;
  max-height: 340px;
  background-color: rgba(18, 18, 18, 0.48);
}

#aioStreamingTile[aio_selected="true"] {
  border: 2px solid rgba(255, 255, 255, 0.88);
  background-color: rgba(100, 181, 246, 0.08);
}
#aioStreamingTile[brand="youtube"][aio_selected="true"] {
  border: 2px solid rgba(255, 30, 30, 0.90);
}
#aioStreamingTile[brand="netflix"][aio_selected="true"] {
  border: 2px solid rgba(229, 9, 20, 0.90);
}
#aioStreamingTile[brand="disneyplus"][aio_selected="true"] {
  border: 2px solid rgba(50, 100, 240, 0.90);
}
#aioStreamingTile[brand="hulu"][aio_selected="true"] {
  border: 2px solid rgba(28, 231, 131, 0.90);
}

/* ──────────────────── Display & Dev Panel ──────────────────── */

#aioDisplaySurface {
  background-color: #000000;
}

#aioDevPanel {
  background-color: rgba(10, 10, 10, 0.96);
  color: #8cf3c7;
  font-family: "SF Mono", "Menlo", monospace;
  padding: 16px;
  border-left: 1px solid rgba(255, 255, 255, 0.06);
}

/* ──────────────────── Scrollbars ──────────────────── */

QScrollBar:vertical {
  background: transparent;
  width: 8px;
  margin: 0px;
}

QScrollBar::handle:vertical {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 4px;
  min-height: 40px;
}

QScrollBar::handle:vertical:hover {
  background: rgba(255, 255, 255, 0.24);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: transparent;
  height: 0px;
}

QScrollBar:horizontal {
  background: transparent;
  height: 8px;
  margin: 0px;
}

QScrollBar::handle:horizontal {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 4px;
  min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
  background: rgba(255, 255, 255, 0.24);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: transparent;
  width: 0px;
}

/* ══════════════════════════════════════════════════════════════
   HomeScreen
   ══════════════════════════════════════════════════════════════ */

#aioHomeTopBar {
  background-color: transparent;
  border-bottom: 1px solid rgba(255,255,255,0.10);
  padding: 8px 0;
}

/* Section headers */
#aioHomeSectionHeader {
  color: rgba(240,240,240,0.85);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.2px;
  padding: 8px 4px 8px 8px;
  background: transparent;
}

#aioHomeBrand {
  color: rgba(240,240,240,0.80);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

#aioHomeClock {
  color: rgba(240, 240, 240, 0.82);
  font-size: 18px;
  font-weight: 600;
}

#aioHomeHero {
  background-color: rgba(255, 255, 255, 0.015);
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

#aioHomeHeroEyebrow {
  color: #64b5f6;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 1.4px;
}

#aioHomeHeroTitle {
  color: #f0f0f0;
  font-size: 48px;
  font-weight: 800;
  letter-spacing: -0.4px;
}

#aioHomeHeroSubtitle {
  color: rgba(240, 240, 240, 0.78);
  font-size: 20px;
}

#aioHomeModeChip {
  background-color: rgba(100, 181, 246, 0.12);
  border: 1px solid rgba(100, 181, 246, 0.28);
  border-radius: 14px;
  padding: 8px 18px;
  color: #90caf9;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 1.0px;
}

#aioHomeModeChip[mode="organize"] {
  background-color: rgba(255,179,77,0.12);
  border: 1px solid rgba(255, 183, 77, 0.32);
  color: #ffb74d;
}

#aioHomeHint {
  font-size: 16px;
  color: rgba(240,240,240,0.58);
}

#aioHomeGridHost {
  background-color: transparent;
  border: none;
}

#aioHomeTile {
  background: transparent;
  border: none;
}

/* ── Add Apps Overlay (organize mode) ──────────────────── */

#aioAddAppsOverlay {
  background-color: rgba(10, 10, 10, 0.96);
  border: 2px solid rgba(255, 183, 77, 0.40);
  border-radius: 16px;
}

#aioAddAppsTitle {
  color: #ffb74d;
  font-size: 32px;
  font-weight: 700;
}

#aioAddAppsHint {
  color: rgba(204, 204, 204, 0.64);
  font-size: 14px;
  font-weight: 500;
}

#aioAddAppsItem {
  background-color: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 12px 24px;
  color: rgba(240, 240, 240, 0.80);
  font-size: 14px;
  font-weight: 600;
}

#aioAddAppsItem[aio_selected="true"] {
  background-color: rgba(255,179,77,0.12);
  border: 2px solid rgba(255, 204, 128, 0.64);
  color: #ffb74d;
}

/* ══════════════════════════════════════════════════════════════
   Screen Mirror
   ══════════════════════════════════════════════════════════════ */

#screenMirrorWaiting,
#screenMirrorActive {
  background-color: transparent;
}

#screenMirrorCenter {
  background-color: transparent;
}

#screenMirrorTitle {
  font-size: 48px;
  font-weight: 800;
  color: #f0f0f0;
}

#screenMirrorSubtitle {
  font-size: 18px;
  font-weight: 500;
  color: #999999;
}

#screenMirrorSubtitle[state="error"] {
  font-size: 18px;
  font-weight: 600;
  color: #ef5350;
}

#screenMirrorIp {
  font-size: 20px;
  font-weight: 600;
  color: #f0f0f0;
}

#screenMirrorInstruction {
  font-size: 18px;
  font-weight: 400;
  color: rgba(153,153,153,0.88);
}

#screenMirrorDots {
  font-size: 14px;
  font-weight: 600;
  color: #64b5f6;
}

#screenMirrorBottomBar {
  background-color: transparent;
}

#screenMirrorBackBtn {
  min-width: 160px;
  font-size: 16px;
  font-weight: 600;
  color: #cccccc;
}

#screenMirrorBackBtn:focus {
  background-color: rgba(100, 181, 246, 0.12);
  border: 2px solid rgba(255, 255, 255, 0.88);
  color: #ffffff;
}

#screenMirrorVideo {
  background-color: #000000;
}

#screenMirrorOverlay {
  background-color: rgba(10, 10, 10, 0.72);
  color: #f0f0f0;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 24px;
  border-radius: 12px;
}

/* ══════════════════════════════════════════════════════════════
   Sliders (global)
   ══════════════════════════════════════════════════════════════ */

QSlider::groove:horizontal {
  border: none;
  height: 6px;
  border-radius: 3px;
  background-color: #222222;
}

QSlider::sub-page:horizontal {
  border-radius: 3px;
  background-color: #64b5f6;
}

QSlider::add-page:horizontal {
  border-radius: 3px;
  background-color: #222222;
}

QSlider::handle:horizontal {
  background-color: #f0f0f0;
  width: 16px;
  height: 16px;
  margin: -6px 0;
  border-radius: 8px;
  border: 2px solid rgba(0, 0, 0, 0.24);
}

QSlider::handle:horizontal:hover {
  background-color: #ffffff;
  border: 2px solid rgba(100, 181, 246, 0.64);
}

QSlider::handle:horizontal:focus {
  background-color: #ffffff;
  border: 2px solid rgba(100, 181, 246, 0.88);
}

/* ══════════════════════════════════════════════════════════════
   Checkboxes (dark theme indicator)
   ══════════════════════════════════════════════════════════════ */

QCheckBox {
  color: #f0f0f0;
  font-size: 14px;
  spacing: 12px;
  padding: 4px 0;
}

QCheckBox::indicator {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  border: 2px solid rgba(255, 255, 255, 0.20);
  background-color: #1a1a1a;
}

QCheckBox::indicator:hover {
  border: 2px solid rgba(255, 255, 255, 0.36);
  background-color: #222222;
}

QCheckBox::indicator:checked {
  background-color: #64b5f6;
  border: 2px solid #64b5f6;
  image: none;
}

QCheckBox::indicator:checked:hover {
  background-color: #90caf9;
  border: 2px solid #90caf9;
}

/* ══════════════════════════════════════════════════════════════
   Dialogs (global dark theme)
   ══════════════════════════════════════════════════════════════ */

QDialog {
  background-color: #0a0a0a;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 16px;
}

/* ══════════════════════════════════════════════════════════════
   Tables (dark theme — CheatDialog etc.)
   ══════════════════════════════════════════════════════════════ */

QTableWidget {
  background-color: #121212;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  gridline-color: rgba(255, 255, 255, 0.06);
  font-size: 14px;
  selection-background-color: rgba(100, 181, 246, 0.16);
  selection-color: #ffffff;
}

QTableWidget::item {
  padding: 8px 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QTableWidget::item:selected {
  background-color: rgba(100, 181, 246, 0.16);
}

QHeaderView::section {
  background-color: #1a1a1a;
  color: #999999;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.6px;
  padding: 10px 12px;
  border: none;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* ══════════════════════════════════════════════════════════════
   Tabs (dark theme — StreamingDialog etc.)
   ══════════════════════════════════════════════════════════════ */

QTabWidget::pane {
  background-color: #0a0a0a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 8px;
}

QTabBar::tab {
  background-color: #121212;
  color: #999999;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-bottom: none;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  padding: 10px 24px;
  font-size: 14px;
  font-weight: 600;
  min-width: 100px;
}

QTabBar::tab:selected {
  background-color: #1a1a1a;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-bottom: 2px solid #64b5f6;
}

QTabBar::tab:hover:!selected {
  background-color: rgba(255, 255, 255, 0.04);
  color: #cccccc;
}

/* ══════════════════════════════════════════════════════════════
   Scroll Area (frameless for embedded scroll containers)
   ══════════════════════════════════════════════════════════════ */

QScrollArea {
  background-color: transparent;
  border: none;
}

/* ══════════════════════════════════════════════════════════════
   NAS Toolbar Buttons
   ══════════════════════════════════════════════════════════════ */

#nasToolbar QPushButton {
  min-height: 44px;
  padding: 10px 20px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 12px;
}

/* ══════════════════════════════════════════════════════════════
   Footer / Version Labels
   ══════════════════════════════════════════════════════════════ */

QLabel[role="footer"] {
  font-size: 12px;
  color: rgba(153, 153, 153, 0.48);
  font-weight: 500;
}

/* ══════════════════════════════════════════════════════════════
   Games Library
   ══════════════════════════════════════════════════════════════ */

#aioGamesLibraryPage {
  background-color: #0a0a0a;
}

#aioGamesLibraryHeader {
  padding: 24px 32px 16px 32px;
  background: transparent;
}

#aioGamesLibraryTitle {
  color: #f0f0f0;
  font-size: 32px;
  font-weight: 700;
}

#aioGamesLibrarySubtitle {
  color: #999999;
  font-size: 16px;
  font-weight: 500;
}

#aioGamesLibraryBody {
  background: transparent;
}

#aioGamesRailPanel {
  background: #121212;
  border: 1px solid transparent;
  border-radius: 16px;
}

#aioGamesRailHeading {
  color: #f0f0f0;
  font-size: 20px;
  font-weight: 600;
}

#aioGamesFilterBar {
  padding: 0;
  background: transparent;
}

#aioGamesFilterChip {
  color: #999999;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 16px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

#aioGamesFilterChip[active="true"],
#aioGamesFilterChip[focused="true"] {
  color: #ffffff;
  background: rgba(100, 181, 246, 0.20);
  border: 2px solid rgba(100, 181, 246, 0.70);
}

#aioGamesTitleRail {
  background: #0a0a0a;
  border: 1px solid transparent;
  border-radius: 16px;
  padding: 12px;
}

#aioGamesTitleRail::item {
  min-height: 64px;
  padding: 12px 16px;
  margin: 4px 0;
  border-radius: 12px;
  color: #f0f0f0;
  font-size: 16px;
  font-weight: 500;
}

#aioGamesTitleRail::item:hover {
  background: rgba(255, 255, 255, 0.04);
}

#aioGamesTitleRail::item:selected {
  background: rgba(212, 168, 32, 0.16);
  border: 2px solid rgba(212, 168, 32, 0.56);
  color: #ffffff;
}

#aioGamesRailHint {
  color: #999999;
  font-size: 13px;
}

#aioGamesDetailsPane {
  background: transparent;
}

#aioGamesHeroCard {
  background: #121212;
  border: 1px solid transparent;
  border-radius: 16px;
}

#aioGamesHeroArt {
  background: transparent;
  border-radius: 16px;
}

#aioGamesHeroBadge {
  color: #64b5f6;
  background: rgba(100, 181, 246, 0.16);
  border: 1px solid rgba(100, 181, 246, 0.30);
  border-radius: 20px;
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 700;
}

#aioGamesHeroTitle {
  color: #f0f0f0;
  font-size: 32px;
  font-weight: 700;
}

#aioGamesHeroSubtitle {
  color: #64b5f6;
  font-size: 20px;
  font-weight: 600;
}

#aioGamesHeroDescription {
  color: #999999;
  font-size: 16px;
}

#aioGamesStatCard {
  background: #121212;
  border: 1px solid transparent;
  border-radius: 16px;
}

#aioGamesStatEyebrow {
  color: #666666;
  font-size: 13px;
  font-weight: 700;
}

#aioGamesStatValue {
  color: #f0f0f0;
  font-size: 20px;
  font-weight: 600;
}

#aioGamesPrimaryAction {
  background-color: #d4a820;
  color: #0a0a0a;
  border: none;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 700;
  min-height: 52px;
}

#aioGamesPrimaryAction:hover,
#aioGamesPrimaryAction:focus,
#aioGamesPrimaryAction[aio_selected="true"] {
  background-color: rgba(212, 168, 32, 0.88);
}

#aioGamesSecondaryAction {
  background-color: #1a1a1a;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  min-height: 52px;
}

#aioGamesSecondaryAction:hover,
#aioGamesSecondaryAction:focus,
#aioGamesSecondaryAction[aio_selected="true"] {
  background-color: #222222;
  border: 2px solid rgba(255, 255, 255, 0.42);
}

#aioGamesEmptyLabel {
  color: #999999;
  font-size: 16px;
}

#aioGamesInfoDialog {
  background: #121212;
}

#aioGamesDialogArt {
  background: transparent;
  border-radius: 16px;
}

#aioGamesDialogTitle {
  color: #f0f0f0;
  font-size: 32px;
  font-weight: 700;
}

#aioGamesDialogMeta {
  color: #64b5f6;
  font-size: 16px;
  font-weight: 600;
}

#aioGamesDialogBody {
  color: #999999;
  font-size: 16px;
}

#aioGamesDialogPath {
  color: #666666;
  font-size: 13px;
}

/* ══════════════════════════════════════════════════════════════
   Game Store
   ══════════════════════════════════════════════════════════════ */

#aioGameStorePage {
  background-color: #0a0a0a;
}

#aioStoreGridHost {
  background-color: #0a0a0a;
}

#aioStoreHeader {
  background: transparent;
  padding: 16px 48px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

#aioStoreTitle {
  color: #f0f0f0;
  font-size: 32px;
  font-weight: 700;
}

#aioStoreSubtitle {
  color: #999999;
  font-size: 16px;
}

#aioStoreBackHint {
  color: #666666;
  font-size: 13px;
}

#aioStoreTabBar {
  background: transparent;
  padding: 8px 48px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

#aioStoreTabLabel {
  color: rgba(240, 240, 240, 0.50);
  font-size: 16px;
  font-weight: 600;
  padding: 12px 24px;
  border-radius: 20px;
  background: transparent;
}

#aioStoreTabLabel[aio_active="true"] {
  color: #f0f0f0;
  background: rgba(212, 168, 32, 0.08);
  border: 1px solid rgba(212, 168, 32, 0.22);
}

#aioStoreTabLabel[aio_selected="true"] {
  color: #d4a820;
  background: rgba(212, 168, 32, 0.14);
  border: 2px solid rgba(212, 168, 32, 0.50);
}

#aioStoreShelfHeader {
  background: transparent;
}

#aioStoreShelfEyebrow {
  color: #d4a820;
  font-size: 13px;
  font-weight: 700;
}

#aioStoreShelfTitle {
  color: #f0f0f0;
  font-size: 32px;
  font-weight: 700;
}

#aioStoreShelfSummary {
  color: #999999;
  font-size: 16px;
}

#aioStoreControlsBar {
  background: transparent;
}

#aioStoreSearchPanel {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 20px;
}

#aioStoreSearchLabel {
  color: #d4a820;
  font-size: 13px;
  font-weight: 700;
}

#aioStoreSearchValue {
  color: rgba(240, 240, 240, 0.58);
  font-size: 15px;
  font-weight: 500;
}

#aioStoreSearchValue[aio_active="true"] {
  color: #f0f0f0;
}

#aioStoreDetailOverlay {
  background: rgba(0, 0, 0, 0.78);
}

#aioGameCard {
  background: transparent;
  border-radius: 16px;
  border: none;
}

#aioStoreCardTitle {
  color: #f0f0f0;
  padding: 8px 12px 4px 12px;
  background: rgba(10, 10, 10, 0.56);
  border-top-left-radius: 12px;
  border-top-right-radius: 12px;
}

#aioStoreCardMeta {
  color: #f0f0f0;
  padding: 0 12px 12px 12px;
  background: rgba(10, 10, 10, 0.72);
  border-bottom-left-radius: 12px;
  border-bottom-right-radius: 12px;
}

#aioStoreCardMeta[aio_tone="library"] {
  color: #64b5f6;
}

#aioStoreCardMeta[aio_tone="sale"] {
  color: #d4a820;
}

/* GameCard focus ring is handled entirely in GameStorePage.cpp :: GameCard::
   paintEvent for crisp sub-pixel accuracy. */

#aioStoreDetailPanel {
  background: #141414;
  border: 1px solid transparent;
  border-radius: 16px;
  padding: 12px;
}

#aioStoreDetailArt {
  background: transparent;
  border-radius: 12px;
}

#aioStoreSkeletonThumb {
  background-color: #353535;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 12px;
}

#aioStoreDetailTitle {
  color: #ffffff;
  font-size: 32px;
  font-weight: 700;
  padding: 4px 0;
}

#aioStoreDetailMeta {
  color: #999999;
  font-size: 14px;
}

#aioStoreDetailRating {
  color: #d4a820;
  font-size: 16px;
  font-weight: 700;
}

#aioStoreDetailCategory {
  color: #64b5f6;
  background: rgba(100, 181, 246, 0.12);
  border: 1px solid rgba(100, 181, 246, 0.30);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 12px;
  font-weight: 600;
}

#aioStoreDetailDesc {
  color: #cccccc;
  font-size: 15px;
  line-height: 1.4;
}


#aioStoreStateCard {
  background: #121212;
  border: 1px solid transparent;
  border-radius: 16px;
}

#aioStoreStateTitle {
  color: #f0f0f0;
  font-size: 20px;
  font-weight: 600;
}

#aioStoreStateBody {
  color: #999999;
  font-size: 16px;
}


#aioStoreToast {
  background: rgba(18, 18, 18, 0.94);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  padding: 12px 24px;
  color: #f0f0f0;
  font-size: 16px;
}


/* ===== Game Store ===== */
#aioStoreInstalledBadge {
    background-color: rgba(63, 185, 80, 0.18);
  color: #64b5f6;
    border: 1px solid rgba(63, 185, 80, 0.32);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    padding: 2px 8px;
}

#aioStorePlayButton {
  background-color: #d4a820;
    color: #0a0a0a;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
    min-height: 44px;
}

#aioStorePlayButton:hover, #aioStorePlayButton:focus {
  background-color: rgba(212, 168, 32, 0.85);
}

#aioStoreInstallButton {
  background-color: #64b5f6;
    color: #0a0a0a;
  border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
    min-height: 44px;
}

#aioStoreInstallButton:hover, #aioStoreInstallButton:focus {
    background-color: #82c4f8;
}

#aioStoreErrorCard {
    background-color: rgba(220, 50, 50, 0.16);
    border: 1px solid rgba(220, 50, 50, 0.32);
    border-radius: 16px;
    padding: 32px;
}

#aioStoreErrorCard QLabel {
    color: #f0f0f0;
    font-size: 16px;
}

/* ── Account Settings Page ─────────────────────────────────────────────── */

#aioStoreAccountPage {
  background: transparent;
}

#aioStoreAccountCard {
  background: #141414;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
}

#aioStoreAccountCardTitle {
  color: #f0f0f0;
  font-size: 26px;
  font-weight: 700;
}

#aioStoreAccountCardInfo {
  color: #888888;
  font-size: 14px;
  line-height: 1.6;
}

#aioStoreAccountDivider {
  background: rgba(255, 255, 255, 0.07);
  max-height: 1px;
  border: none;
}

#aioStoreAccountMsg {
  color: #ef9a9a;
  font-size: 13px;
}

#aioStoreAccountMsg[aio_tone="success"] {
  color: #a5d6a7;
}

/* Primary CTA — Sign in with Steam */
#aioStoreAccountBtn[aio_role="primary"] {
  color: #ffffff;
  font-size: 17px;
  font-weight: 700;
  background: #1a9fff;
  border: 2px solid transparent;
  border-radius: 10px;
  padding: 16px 24px;
  min-height: 56px;
  text-align: center;
}

#aioStoreAccountBtn[aio_role="primary"][aio_focused="true"],
#aioStoreAccountBtn[aio_role="primary"]:hover {
  background: #3ab0ff;
  border: 2px solid rgba(255, 255, 255, 0.30);
}

#aioStoreAccountBtn[aio_role="primary"]:pressed {
  background: #0d8fe0;
}

/* Secondary — Disconnect */
#aioStoreAccountBtn[aio_role="secondary"] {
  color: rgba(240, 240, 240, 0.40);
  font-size: 14px;
  font-weight: 600;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 8px;
  padding: 12px 24px;
  min-height: 44px;
  text-align: center;
}

#aioStoreAccountBtn[aio_role="secondary"][aio_focused="true"],
#aioStoreAccountBtn[aio_role="secondary"]:hover {
  color: #ef9a9a;
  border: 1px solid rgba(239, 154, 154, 0.40);
  background: rgba(239, 154, 154, 0.07);
}

#aioStoreAccountBtn[aio_role="secondary"]:pressed {
  background: rgba(239, 154, 154, 0.12);
}

#aioStoreAccountHint {
  color: #3a3a3a;
  font-size: 12px;
}

#aioStoreAccountStatus {
  color: #555555;
  font-size: 13px;
}

#aioStoreAccountStatus[aio_auth_state="signed-in"] {
  color: #a5d6a7;
}

#aioStoreAccountStatus[aio_auth_state="signed-out"] {
  color: #555555;
}

/* ── Steam Sign-In Dialog ──────────────────────────────────────────────── */

#aioSteamDialog {
  background: #161616;
  border: 1px solid rgba(255, 255, 255, 0.10);
}

#aioSteamDialogTitleBar {
  background: #1a1a1a;
}

#aioSteamDialogSep {
  background: rgba(255, 255, 255, 0.07);
  max-height: 1px;
  border: none;
}

#aioSteamDialogTitle {
  color: #e8e8e8;
  font-size: 16px;
  font-weight: 600;
}

#aioSteamDialogClose {
  color: #555555;
  background: transparent;
  border: none;
  border-radius: 6px;
  font-size: 15px;
  font-weight: 700;
  padding: 0px;
}

#aioSteamDialogClose:hover {
  color: #cccccc;
  background: rgba(255, 255, 255, 0.08);
}

#aioSteamDialogClose:pressed {
  background: rgba(255, 255, 255, 0.14);
}

#aioSteamDialogLoading {
  background: #161616;
}

#aioSteamDialogLoadingText {
  color: #555555;
  font-size: 15px;
  font-weight: 500;
}