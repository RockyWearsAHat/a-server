/* AIO Entertainment System - shared native shell */

QMainWindow {
  background-color: #08111b;
  color: #edf3ff;
}

QWidget {
  background-color: transparent;
  color: #edf3ff;
  font-family: "Noto Sans", "SF Pro Display", ".AppleSystemUIFont", "Helvetica Neue", sans-serif;
  font-size: 16px;
}

QWidget#aioHomeScreen,
QWidget#aioMainMenuPage,
QWidget#aioEmulatorSelectPage,
QWidget#aioGameSelectPage,
QWidget#aioSettingsPage,
QWidget#aioEmulatorSettingsPage,
QWidget#aioStreamingHub,
QWidget#aioStreamingWebPage,
QWidget#nasPageRoot,
QWidget#aioEmulatorPage {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
    stop:0 #060e1a,
    stop:0.35 #0a1520,
    stop:0.65 #0d1928,
    stop:1 #111e2e);
}

QLabel {
  color: #edf3ff;
  background-color: transparent;
}

QLabel[role="title"] {
  font-size: 34px;
  font-weight: 800;
  color: #f7fbff;
}

QLabel[role="subtitle"] {
  font-size: 15px;
  color: #93a4bb;
}

QLabel[role="sectionEyebrow"] {
  font-size: 13px;
  font-weight: 700;
  color: #67c1ff;
}

#aioTopBar {
  background-color: rgba(7, 11, 18, 0.78);
  border-bottom: 1px solid rgba(129, 155, 186, 0.18);
}

QToolButton,
QPushButton {
  background-color: rgba(21, 31, 44, 0.94);
  color: #f5f9ff;
  border: 1px solid rgba(125, 149, 177, 0.24);
  border-radius: 16px;
  padding: 14px 18px;
  font-size: 18px;
  font-weight: 700;
  min-height: 52px;
  transition: background-color 150ms ease, border 150ms ease;
}

QToolButton {
  min-height: 34px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 600;
  border-radius: 12px;
}

QPushButton:hover,
QToolButton:hover {
  background-color: rgba(32, 47, 66, 0.98);
  border: 1px solid rgba(160, 183, 209, 0.34);
}

QPushButton:pressed,
QToolButton:pressed {
  background-color: rgba(16, 24, 35, 1.0);
}

QPushButton[variant="secondary"],
QToolButton[variant="secondary"] {
  background-color: rgba(14, 22, 31, 0.92);
  color: #dbe6f3;
}

QPushButton[variant="danger"] {
  background-color: rgba(83, 28, 33, 0.92);
  border: 1px solid rgba(215, 96, 102, 0.48);
}

QPushButton[aio_selected="true"],
QPushButton[aio_selected="true"]:hover,
QPushButton[variant][aio_selected="true"],
QPushButton[variant][aio_selected="true"]:hover,
QToolButton[aio_selected="true"],
QToolButton[aio_selected="true"]:hover {
  background-color: rgba(64, 118, 170, 0.28);
  border: 2px solid rgba(210, 230, 255, 0.85);
  color: #ffffff;
}

QPushButton[nav_kind="main"] {
  min-height: 72px;
  padding: 18px 28px;
  font-size: 22px;
  text-align: left;
  background-color: rgba(15, 24, 35, 0.9);
  border-left: 5px solid rgba(103, 193, 255, 0.45);
}

QPushButton[nav_kind="main"]:hover {
  border-left: 5px solid rgba(103, 193, 255, 0.75);
}

QPushButton[nav_kind="main"][aio_selected="true"] {
  border-left: 5px solid rgba(103, 193, 255, 1.0);
}

QPushButton[system="gba"],
QPushButton[system="ps1"],
QPushButton[system="switch"] {
  text-align: left;
  padding-left: 24px;
}

QPushButton[system="gba"] {
  border-left: 6px solid #7c8cff;
}

QPushButton[system="ps1"] {
  border-left: 6px solid #4dc4ff;
}

QPushButton[system="switch"] {
  border-left: 6px solid #ff7670;
}

QPushButton[system="gba"][aio_selected="true"] {
  border-left: 6px solid #9ea9ff;
}

QPushButton[system="ps1"][aio_selected="true"] {
  border-left: 6px solid #86d9ff;
}

QPushButton[system="switch"][aio_selected="true"] {
  border-left: 6px solid #ff9d97;
}

QListWidget {
  background-color: rgba(13, 21, 30, 0.82);
  border: 1px solid rgba(125, 149, 177, 0.24);
  border-radius: 18px;
  padding: 14px;
  font-size: 18px;
}

QListWidget::item {
  padding: 10px;
  border-radius: 12px;
  margin: 4px 0;
}

QListWidget::item:selected {
  background-color: rgba(64, 118, 170, 0.26);
  border: 1.5px solid rgba(206, 226, 248, 0.72);
}

QListWidget::item:hover {
  background-color: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(160, 183, 209, 0.14);
}

QListWidget#nasList,
QListWidget#aioGameGrid {
  padding: 18px;
  border-radius: 22px;
}

QListWidget#aioGameGrid {
  background-color: rgba(10, 16, 24, 0.60);
}

QListWidget#aioGameGrid::item {
  padding: 12px;
  margin: 6px;
  border-radius: 14px;
}

QListWidget#aioGameGrid::item:selected {
  background-color: rgba(64, 118, 170, 0.22);
  border: 1.5px solid rgba(206, 226, 248, 0.60);
}

QLineEdit,
QPlainTextEdit {
  background-color: rgba(12, 19, 28, 0.88);
  border: 1px solid rgba(125, 149, 177, 0.24);
  border-radius: 16px;
  padding: 12px 16px;
  font-size: 17px;
  color: #edf3ff;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QListWidget:focus {
  border: 2px solid rgba(103, 193, 255, 0.9);
}

QCheckBox {
  color: #edf3ff;
}

QGroupBox {
  background-color: rgba(9, 16, 24, 0.65);
  border: 1px solid rgba(125, 149, 177, 0.16);
  border-radius: 22px;
  margin-top: 18px;
  padding: 22px 20px 20px 20px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 18px;
  padding: 0 10px;
  color: #9fbedc;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.3px;
}

#aioPathLabel,
#nasPath {
  background-color: rgba(10, 17, 25, 0.82);
  border: 1px solid rgba(125, 149, 177, 0.22);
  border-radius: 14px;
  padding: 12px 14px;
  color: #d8e4f1;
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 13px;
}

#nasStatus,
#aioStreamingWebStatus,
#aioStreamingWebErrorLabel {
  color: #93a4bb;
  font-size: 14px;
}

#aioStreamingWebErrorStrip {
  background-color: rgba(58, 22, 28, 0.72);
  border-top: 1px solid rgba(215, 96, 102, 0.22);
  border-bottom: 1px solid rgba(215, 96, 102, 0.22);
}

#nasPreviewInfo,
#nasImage,
#nasText {
  background-color: rgba(10, 17, 25, 0.72);
  border: 1px solid rgba(125, 149, 177, 0.18);
  border-radius: 18px;
}

#nasPreviewInfo {
  padding: 14px;
  color: #d6e3f0;
}

#nasImage {
  padding: 10px;
}

#aioStreamingHubTitle {
  font-size: 18px;
  font-weight: 700;
  color: #9fbedc;
  padding-left: 4px;
}

#aioStreamingTile {
  border: 1.5px solid rgba(255, 255, 255, 0.06);
  border-radius: 20px;
  min-width: 200px;
  min-height: 260px;
}

#aioStreamingTile[aio_selected="true"] {
  border: 1.5px solid rgba(255, 255, 255, 0.18);
}

#aioDisplaySurface {
  background-color: #02070d;
}

#aioDevPanel {
  background-color: rgba(4, 8, 13, 0.92);
  color: #8cf3c7;
  font-family: "SF Mono", "Menlo", monospace;
  padding: 14px;
  border-left: 1px solid rgba(125, 149, 177, 0.20);
}

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 0px;
}

QScrollBar::handle:vertical {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 5px;
  min-height: 40px;
}

QScrollBar::handle:vertical:hover {
  background: rgba(255, 255, 255, 0.28);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: transparent;
  height: 0px;
}

/* ──────────────────── HomeScreen ──────────────────── */

#aioHomeTile {
  background: transparent;
  border: none;
}
