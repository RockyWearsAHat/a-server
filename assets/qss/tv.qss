/* ══════════════════════════════════════════════════════════════
   AIO Entertainment System — TV Shell Design System
   ──────────────────────────────────────────────────────────────
   Palette
     bg:       #0a0a0a          surface-1: #121212
     surface-2:#1a1a1a          surface-3: #222222
     elevated: #2a2a2a          border:    rgba(255,255,255,0.06)
     text:     #f0f0f0          text-2:    #999999
     text-3:   #666666          accent:    #64b5f6
   Typography  (Noto Sans)
     display 48/800  heading 32/700  section 20/600
     body 16/500     caption 14/500  meta 13/500  small 12/500
   Spacing     4 · 8 · 12 · 16 · 24 · 32 · 48 · 64
   Radius      card 16  button 12  chip 20  badge 6  input 12
   ══════════════════════════════════════════════════════════════ */

/* ──────────────────── Foundation ──────────────────── */

QMainWindow {
  background-color: #0a0a0a;
  color: #f0f0f0;
}

QWidget {
  background-color: transparent;
  color: #f0f0f0;
  font-family: "Noto Sans", sans-serif;
  font-size: 14px;
}

/* ──────────────────── Page Backgrounds ──────────────────── */

QWidget#aioHomeScreen,
QWidget#aioMainMenuPage,
QWidget#aioEmulatorSelectPage,
QWidget#aioGameSelectPage,
QWidget#aioSettingsPage,
QWidget#aioEmulatorSettingsPage,
QWidget#aioStreamingHub,
QWidget#aioStreamingWebPage,
QWidget#nasPageRoot,
QWidget#aioScreenMirrorPage,
QWidget#aioGamesLibraryPage,
QWidget#aioGameStorePage,
QWidget#aioEmulatorPage {
  background-color: #0a0a0a;
}

/* ──────────────────── Labels ──────────────────── */

QLabel {
  color: #f0f0f0;
  background-color: transparent;
}

QLabel[role="title"] {
  font-size: 32px;
  font-weight: 700;
  color: #f0f0f0;
}

QLabel[role="subtitle"] {
  font-size: 18px;
  color: #999999;
}

QLabel[role="sectionEyebrow"] {
  font-size: 13px;
  font-weight: 700;
  color: #64b5f6;
  letter-spacing: 1.6px;
}

/* ──────────────────── Top Bar ──────────────────── */

#aioTopBar {
  background-color: rgba(10, 10, 10, 0.92);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding: 4px 0;
}

/* ──────────────────── Buttons ──────────────────── */

QToolButton,
QPushButton {
  background-color: #1a1a1a;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 16px 24px;
  font-size: 14px;
  font-weight: 600;
  min-height: 52px;
}

QToolButton {
  min-height: 32px;
  padding: 8px 16px;
  font-size: 13px;
  font-weight: 600;
  border-radius: 8px;
}

QPushButton:hover,
QToolButton:hover {
  background-color: #222222;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

QPushButton:pressed,
QToolButton:pressed {
  background-color: #161616;
}

QPushButton[variant="secondary"],
QToolButton[variant="secondary"] {
  background-color: #121212;
  color: #cccccc;
}

QPushButton[variant="danger"] {
  background-color: rgba(220, 50, 50, 0.16);
  border: 1px solid rgba(220, 50, 50, 0.32);
  color: #f0a0a0;
}

/* ── Focus / Selected (universal) ── */

QPushButton[aio_selected="true"],
QPushButton[aio_selected="true"]:hover,
QPushButton[variant][aio_selected="true"],
QPushButton[variant][aio_selected="true"]:hover,
QToolButton[aio_selected="true"],
QToolButton[aio_selected="true"]:hover {
  background-color: rgba(100, 181, 246, 0.22);
  border: 3px solid #ffffff;
  color: #ffffff;
}

/* ── Main nav buttons ── */

QPushButton[nav_kind="main"] {
  min-height: 64px;
  padding: 16px 24px;
  font-size: 20px;
  text-align: left;
  background-color: #121212;
  border-left: 4px solid rgba(100, 181, 246, 0.32);
}

QPushButton[nav_kind="main"]:hover {
  border-left: 4px solid rgba(100, 181, 246, 0.56);
}

QPushButton[nav_kind="main"][aio_selected="true"] {
  border-left: 4px solid #64b5f6;
}

/* ── System-branded buttons ── */

QPushButton[system="gba"],
QPushButton[system="ps1"],
QPushButton[system="switch"] {
  text-align: left;
  padding-left: 24px;
}

QPushButton[system="gba"] {
  border-left: 4px solid #9c8cff;
}

QPushButton[system="ps1"] {
  border-left: 4px solid #64b5f6;
}

QPushButton[system="switch"] {
  border-left: 4px solid #ff6b6b;
}

QPushButton[system="gba"][aio_selected="true"] {
  border-left: 4px solid #b8a8ff;
}

QPushButton[system="ps1"][aio_selected="true"] {
  border-left: 4px solid #90caf9;
}

QPushButton[system="switch"][aio_selected="true"] {
  border-left: 4px solid #ff9090;
}

/* ──────────────────── Lists ──────────────────── */

QListWidget {
  background-color: #121212;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
  padding: 12px;
  font-size: 14px;
}

QListWidget::item {
  padding: 12px;
  border-radius: 8px;
  margin: 4px 0;
}

QListWidget::item:selected {
  background-color: rgba(100, 181, 246, 0.22);
  border: 3px solid #ffffff;
}

QListWidget::item:hover {
  background-color: rgba(255, 255, 255, 0.04);
}

QListWidget#nasList,
QListWidget#aioGameGrid {
  padding: 16px;
  border-radius: 16px;
}

QListWidget#aioGameGrid {
  background-color: rgba(18, 18, 18, 0.80);
}

QListWidget#aioGameGrid::item {
  padding: 12px;
  margin: 4px;
  border-radius: 8px;
}

QListWidget#aioGameGrid::item:selected {
  background-color: rgba(100, 181, 246, 0.12);
  border: 2px solid white;
}

/* ──────────────────── Inputs ──────────────────── */

QLineEdit,
QTextEdit,
QPlainTextEdit {
  background-color: #121212;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 14px;
  color: #f0f0f0;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QListWidget:focus {
  border: 2px solid rgba(100, 181, 246, 0.80);
}

/* ──────────────────── Checkboxes ──────────────────── */

QCheckBox {
  color: #f0f0f0;
}

/* ──────────────────── Group Boxes ──────────────────── */

QGroupBox {
  background-color: rgba(18, 18, 18, 0.80);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
  margin-top: 16px;
  padding: 24px 16px 16px 16px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 16px;
  padding: 0 8px;
  color: #999999;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.4px;
}

/* ──────────────────── NAS Path & Status ──────────────────── */

#aioPathLabel,
#nasPath {
  background-color: #121212;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 12px 16px;
  color: #cccccc;
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 13px;
}

#nasStatus,
#aioStreamingWebStatus,
#aioStreamingWebErrorLabel {
  color: #999999;
  font-size: 14px;
  padding-left: 16px;
}

#aioStreamingWebErrorStrip {
  background-color: rgba(220, 50, 50, 0.12);
  border-top: 1px solid rgba(220, 50, 50, 0.24);
  border-bottom: 1px solid rgba(220, 50, 50, 0.24);
  padding: 12px 0;
}

#aioStreamingWebErrorLabel {
  color: #f0a0a0;
  font-size: 18px;
  font-weight: 600;
}

/* ──────────────────── Streaming Bar Buttons ──────────────────── */

#aioStreamingBarBtn {
  min-height: 40px;
  padding: 8px 16px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 12px;
  background-color: #1a1a1a;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

#aioStreamingBarBtn:focus {
  border: 2px solid rgba(255, 255, 255, 0.88);
  background-color: rgba(100, 181, 246, 0.12);
  color: #ffffff;
}

#aioStreamingBarBtn:hover {
  background-color: #222222;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

#aioStreamingBarBtn:pressed {
  background-color: #2a2a2a;
  border: 2px solid rgba(100, 181, 246, 0.48);
}

#aioStreamingBarBtn:disabled {
  color: rgba(153, 153, 153, 0.36);
  border: 1px solid rgba(255, 255, 255, 0.04);
  background-color: rgba(18, 18, 18, 0.60);
}

#aioStreamingRetryBtn {
  min-height: 44px;
  padding: 12px 24px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 12px;
  border: 1px solid rgba(220, 50, 50, 0.32);
  background-color: rgba(220, 50, 50, 0.12);
  color: #ffd4d4;
}

#aioStreamingRetryBtn:focus {
  border: 2px solid rgba(255, 120, 120, 0.72);
  background-color: rgba(220, 50, 50, 0.20);
}

/* ──────────────────── Streaming Loading Overlay ──────────────────── */

#aioStreamingLoadOverlay {
  background-color: #0a0a0a;
}

#aioStreamingLoadTitle {
  font-size: 48px;
  font-weight: 800;
  color: #f0f0f0;
  letter-spacing: 0.5px;
}

#aioStreamingLoadAccent {
  border-radius: 2px;
}

#aioStreamingLoadIndicator {
  font-size: 18px;
  font-weight: 600;
  color: #999999;
  letter-spacing: 2px;
}

/* ──────────────────── Navigation Hint Strip ──────────────────── */

#aioStreamingNavHint {
  font-size: 14px;
  font-weight: 600;
  color: rgba(170, 170, 170, 0.85);
  background-color: rgba(10, 10, 10, 0.64);
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  padding: 4px 16px;
  letter-spacing: 0.4px;
}

/* ──────────────────── NAS Preview ──────────────────── */

#nasPreviewInfo,
#nasImage,
#nasText {
  background-color: #121212;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
}

#nasPreviewInfo {
  padding: 16px;
  color: #f0f0f0;
}

#nasImage {
  padding: 8px;
}

/* ──────────────────── Streaming Hub ──────────────────── */

#aioStreamingHubTitle {
  font-size: 13px;
  font-weight: 700;
  color: #64b5f6;
  padding-left: 4px;
  letter-spacing: 1.6px;
}

#aioStreamingHubHeadline {
  font-size: 48px;
  font-weight: 800;
  color: #f0f0f0;
}

#aioStreamingHubDescription {
  font-size: 18px;
  color: #999999;
}

#aioStreamingHubResume {
  background-color: rgba(100, 181, 246, 0.10);
  border: 1px solid rgba(100, 181, 246, 0.24);
  border-radius: 12px;
  padding: 8px 16px;
  color: #90caf9;
  font-size: 13px;
  font-weight: 600;
}

#aioStreamingHubHint {
  font-size: 14px;
  color: #666666;
}

/* ──────────────────── Streaming Tiles ──────────────────── */

#aioStreamingTile {
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
  min-width: 220px;
  min-height: 300px;
  max-width: 480px;
  max-height: 340px;
  background-color: rgba(18, 18, 18, 0.48);
}

#aioStreamingTile[aio_selected="true"] {
  border: 2px solid rgba(255, 255, 255, 0.88);
  background-color: rgba(100, 181, 246, 0.08);
}
#aioStreamingTile[brand="youtube"][aio_selected="true"] {
  border: 2px solid rgba(255, 30, 30, 0.90);
}
#aioStreamingTile[brand="netflix"][aio_selected="true"] {
  border: 2px solid rgba(229, 9, 20, 0.90);
}
#aioStreamingTile[brand="disneyplus"][aio_selected="true"] {
  border: 2px solid rgba(50, 100, 240, 0.90);
}
#aioStreamingTile[brand="hulu"][aio_selected="true"] {
  border: 2px solid rgba(28, 231, 131, 0.90);
}

/* ──────────────────── Display & Dev Panel ──────────────────── */

#aioDisplaySurface {
  background-color: #000000;
}

#aioDevPanel {
  background-color: rgba(10, 10, 10, 0.96);
  color: #8cf3c7;
  font-family: "SF Mono", "Menlo", monospace;
  padding: 16px;
  border-left: 1px solid rgba(255, 255, 255, 0.06);
}

/* ──────────────────── Scrollbars ──────────────────── */

QScrollBar:vertical {
  background: transparent;
  width: 8px;
  margin: 0px;
}

QScrollBar::handle:vertical {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 4px;
  min-height: 40px;
}

QScrollBar::handle:vertical:hover {
  background: rgba(255, 255, 255, 0.24);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: transparent;
  height: 0px;
}

QScrollBar:horizontal {
  background: transparent;
  height: 8px;
  margin: 0px;
}

QScrollBar::handle:horizontal {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 4px;
  min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
  background: rgba(255, 255, 255, 0.24);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: transparent;
  width: 0px;
}

/* ══════════════════════════════════════════════════════════════
   HomeScreen
   ══════════════════════════════════════════════════════════════ */

#aioHomeTopBar {
  background-color: transparent;
  border-bottom: 1px solid rgba(255,255,255,0.10);
  padding: 8px 0;
}

/* Section headers */
#aioHomeSectionHeader {
  color: rgba(240,240,240,0.85);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 2.0px;
  padding: 8px 4px 8px 8px;
  background: transparent;
}

#aioHomeBrand {
  color: rgba(240,240,240,0.80);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

#aioHomeClock {
  color: rgba(240, 240, 240, 0.82);
  font-size: 18px;
  font-weight: 600;
}

#aioHomeHero {
  background-color: rgba(255, 255, 255, 0.015);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

#aioHomeHeroEyebrow {
  color: #64b5f6;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 2.2px;
}

#aioHomeHeroTitle {
  color: #f0f0f0;
  font-size: 48px;
  font-weight: 800;
  letter-spacing: -0.4px;
}

#aioHomeHeroSubtitle {
  color: rgba(240, 240, 240, 0.78);
  font-size: 20px;
}

#aioHomeModeChip {
  background-color: rgba(100, 181, 246, 0.12);
  border: 1px solid rgba(100, 181, 246, 0.28);
  border-radius: 14px;
  padding: 8px 18px;
  color: #90caf9;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 1.0px;
}

#aioHomeModeChip[mode="organize"] {
  background-color: rgba(255,179,77,0.12);
  border: 1px solid rgba(255, 183, 77, 0.32);
  color: #ffb74d;
}

#aioHomeHint {
  font-size: 16px;
  color: rgba(240,240,240,0.58);
}

#aioHomeGridHost {
  background-color: transparent;
  border: none;
}

#aioHomeTile {
  background: transparent;
  border: none;
}

/* ── Add Apps Overlay (organize mode) ──────────────────── */

#aioAddAppsOverlay {
  background-color: rgba(10, 10, 10, 0.96);
  border: 2px solid rgba(255, 183, 77, 0.40);
  border-radius: 16px;
}

#aioAddAppsTitle {
  color: #ffb74d;
  font-size: 32px;
  font-weight: 700;
}

#aioAddAppsHint {
  color: rgba(204, 204, 204, 0.64);
  font-size: 14px;
  font-weight: 500;
}

#aioAddAppsItem {
  background-color: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 12px 24px;
  color: rgba(240, 240, 240, 0.80);
  font-size: 14px;
  font-weight: 600;
}

#aioAddAppsItem[aio_selected="true"] {
  background-color: rgba(255,179,77,0.12);
  border: 2px solid rgba(255, 204, 128, 0.64);
  color: #ffb74d;
}

/* ══════════════════════════════════════════════════════════════
   Screen Mirror
   ══════════════════════════════════════════════════════════════ */

#screenMirrorWaiting,
#screenMirrorActive {
  background-color: transparent;
}

#screenMirrorCenter {
  background-color: transparent;
}

#screenMirrorTitle {
  font-size: 48px;
  font-weight: 800;
  color: #f0f0f0;
}

#screenMirrorSubtitle {
  font-size: 18px;
  font-weight: 500;
  color: #999999;
}

#screenMirrorSubtitle[state="error"] {
  font-size: 18px;
  font-weight: 600;
  color: #ef5350;
}

#screenMirrorIp {
  font-size: 20px;
  font-weight: 600;
  color: #f0f0f0;
}

#screenMirrorInstruction {
  font-size: 18px;
  font-weight: 400;
  color: rgba(153,153,153,0.88);
}

#screenMirrorDots {
  font-size: 14px;
  font-weight: 600;
  color: #64b5f6;
}

#screenMirrorBottomBar {
  background-color: transparent;
}

#screenMirrorBackBtn {
  min-width: 160px;
  font-size: 16px;
  font-weight: 600;
  color: #cccccc;
}

#screenMirrorBackBtn:focus {
  background-color: rgba(100, 181, 246, 0.12);
  border: 2px solid rgba(255, 255, 255, 0.88);
  color: #ffffff;
}

#screenMirrorVideo {
  background-color: #000000;
}

#screenMirrorOverlay {
  background-color: rgba(10, 10, 10, 0.72);
  color: #f0f0f0;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 24px;
  border-radius: 12px;
}

/* ══════════════════════════════════════════════════════════════
   Sliders (global)
   ══════════════════════════════════════════════════════════════ */

QSlider::groove:horizontal {
  border: none;
  height: 6px;
  border-radius: 3px;
  background-color: #222222;
}

QSlider::sub-page:horizontal {
  border-radius: 3px;
  background-color: #64b5f6;
}

QSlider::add-page:horizontal {
  border-radius: 3px;
  background-color: #222222;
}

QSlider::handle:horizontal {
  background-color: #f0f0f0;
  width: 16px;
  height: 16px;
  margin: -6px 0;
  border-radius: 8px;
  border: 2px solid rgba(0, 0, 0, 0.24);
}

QSlider::handle:horizontal:hover {
  background-color: #ffffff;
  border: 2px solid rgba(100, 181, 246, 0.64);
}

QSlider::handle:horizontal:focus {
  background-color: #ffffff;
  border: 2px solid rgba(100, 181, 246, 0.88);
}

/* ══════════════════════════════════════════════════════════════
   Checkboxes (dark theme indicator)
   ══════════════════════════════════════════════════════════════ */

QCheckBox {
  color: #f0f0f0;
  font-size: 14px;
  spacing: 12px;
  padding: 4px 0;
}

QCheckBox::indicator {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  border: 2px solid rgba(255, 255, 255, 0.20);
  background-color: #1a1a1a;
}

QCheckBox::indicator:hover {
  border: 2px solid rgba(255, 255, 255, 0.36);
  background-color: #222222;
}

QCheckBox::indicator:checked {
  background-color: #64b5f6;
  border: 2px solid #64b5f6;
  image: none;
}

QCheckBox::indicator:checked:hover {
  background-color: #90caf9;
  border: 2px solid #90caf9;
}

/* ══════════════════════════════════════════════════════════════
   Dialogs (global dark theme)
   ══════════════════════════════════════════════════════════════ */

QDialog {
  background-color: #0a0a0a;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 16px;
}

/* ══════════════════════════════════════════════════════════════
   Tables (dark theme — CheatDialog etc.)
   ══════════════════════════════════════════════════════════════ */

QTableWidget {
  background-color: #121212;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  gridline-color: rgba(255, 255, 255, 0.06);
  font-size: 14px;
  selection-background-color: rgba(100, 181, 246, 0.16);
  selection-color: #ffffff;
}

QTableWidget::item {
  padding: 8px 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QTableWidget::item:selected {
  background-color: rgba(100, 181, 246, 0.16);
}

QHeaderView::section {
  background-color: #1a1a1a;
  color: #999999;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.6px;
  padding: 10px 12px;
  border: none;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* ══════════════════════════════════════════════════════════════
   Tabs (dark theme — StreamingDialog etc.)
   ══════════════════════════════════════════════════════════════ */

QTabWidget::pane {
  background-color: #0a0a0a;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 8px;
}

QTabBar::tab {
  background-color: #121212;
  color: #999999;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-bottom: none;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  padding: 10px 24px;
  font-size: 14px;
  font-weight: 600;
  min-width: 100px;
}

QTabBar::tab:selected {
  background-color: #1a1a1a;
  color: #f0f0f0;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-bottom: 2px solid #64b5f6;
}

QTabBar::tab:hover:!selected {
  background-color: rgba(255, 255, 255, 0.04);
  color: #cccccc;
}

/* ══════════════════════════════════════════════════════════════
   Scroll Area (frameless for embedded scroll containers)
   ══════════════════════════════════════════════════════════════ */

QScrollArea {
  background-color: transparent;
  border: none;
}

/* ══════════════════════════════════════════════════════════════
   NAS Toolbar Buttons
   ══════════════════════════════════════════════════════════════ */

#nasToolbar QPushButton {
  min-height: 44px;
  padding: 10px 20px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 12px;
}

/* ══════════════════════════════════════════════════════════════
   Footer / Version Labels
   ══════════════════════════════════════════════════════════════ */

QLabel[role="footer"] {
  font-size: 12px;
  color: rgba(153, 153, 153, 0.48);
  font-weight: 500;
}

/* ══════════════════════════════════════════════════════════════
   Games Library
   ══════════════════════════════════════════════════════════════ */

#aioGamesLibraryPage {
  background-color: #0a0a0a;
}

#aioGamesLibraryHeader {
  padding: 16px 32px 8px 32px;
  background: transparent;
}

#aioGamesLibraryTitle {
  color: #ffffff;
  font-size: 32px;
  font-weight: 700;
}

#aioGamesLibrarySubtitle {
  color: rgba(255, 255, 255, 0.48);
  font-size: 14px;
  font-weight: 500;
}

#aioGamesFilterBar {
  padding: 0 32px 12px 32px;
  background: transparent;
}

#aioGamesFilterChip {
  color: rgba(240, 240, 240, 0.50);
  font-size: 16px;
  font-weight: 600;
  padding: 10px 22px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

#aioGamesFilterChip[active="true"],
#aioGamesFilterChip[focused="true"] {
  color: #ffffff;
  background: rgba(100, 181, 246, 0.20);
  border: 2px solid rgba(100, 181, 246, 0.70);
}

#aioGameLibraryTile {
  background: transparent;
  border-radius: 12px;
  border: none;
}

/* QSS border is overridden by custom paintEvent — focus state is handled
   entirely in GamesLibraryPage.cpp :: GameTile::paintEvent for pixel accuracy.
   The shadow effect is also applied programmatically in updateGridFocus(). */

#aioGamesEmptyLabel {
  color: rgba(240, 240, 240, 0.45);
  font-size: 16px;
}

/* ══════════════════════════════════════════════════════════════
   Game Store
   ══════════════════════════════════════════════════════════════ */

#aioGameStorePage {
  background-color: #0a0a0a;
}

#aioStoreHeader {
  background: transparent;
  padding: 8px 32px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

#aioStoreTitle {
  color: #ffffff;
  font-size: 32px;
  font-weight: 700;
}

#aioStoreSubtitle {
  color: rgba(255, 255, 255, 0.45);
  font-size: 14px;
}

#aioStoreTabBar {
  background: transparent;
  padding: 0 32px;
}

#aioStoreTabLabel {
  color: rgba(240, 240, 240, 0.50);
  font-size: 16px;
  font-weight: 600;
  padding: 10px 24px;
  border-radius: 20px;
  background: transparent;
}

#aioStoreTabLabel[aio_selected="true"] {
  color: #d4a820;
  background: rgba(212, 168, 32, 0.14);
  border: 2px solid rgba(212, 168, 32, 0.50);
}

#aioGameCard {
  background: transparent;
  border-radius: 12px;
  border: none;
}

/* GameCard focus ring is handled entirely in GameStorePage.cpp :: GameCard::
   paintEvent for crisp sub-pixel accuracy. */

#aioStoreDetailPanel {
  background: #121212;
  border-left: 1px solid rgba(255, 255, 255, 0.08);
}

#aioStoreDetailTitle {
  color: #ffffff;
  font-size: 20px;
  font-weight: 700;
}

#aioStoreDetailMeta {
  color: #999999;
  font-size: 13px;
}

#aioStoreDetailDesc {
  color: #f0f0f0;
  font-size: 14px;
}


#aioStoreToast {
  background: rgba(30, 30, 30, 0.94);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 10px;
  padding: 12px 24px;
  color: #ffffff;
  font-size: 16px;
}


/* ===== Game Store ===== */
#aioStoreInstalledBadge {
    background-color: rgba(63, 185, 80, 0.18);
    color: #3fb950;
    border: 1px solid rgba(63, 185, 80, 0.32);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    padding: 2px 8px;
}

#aioStorePlayButton {
    background-color: #3fb950;
    color: #0a0a0a;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
    min-height: 44px;
}

#aioStorePlayButton:hover, #aioStorePlayButton:focus {
    background-color: #4fc860;
}

#aioStoreInstallButton {
    background-color: #64b5f6;
    color: #0a0a0a;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
    min-height: 44px;
}

#aioStoreInstallButton:hover, #aioStoreInstallButton:focus {
    background-color: #82c4f8;
}

#aioStoreErrorCard {
    background-color: rgba(220, 50, 50, 0.16);
    border: 1px solid rgba(220, 50, 50, 0.32);
    border-radius: 16px;
    padding: 32px;
}

#aioStoreErrorCard QLabel {
    color: #f0f0f0;
    font-size: 16px;
}
